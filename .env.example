# 複製成 .env 後填入金鑰。.env 已被 .gitignore 排除，不會上傳到 GitHub。
# 改完不用重啟任何東西，每次呼叫都會重新讀取。

# --- 用 Vertex AI 金鑰（綁定服務帳號的 API key）
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=

# --- 或改用 AI Studio 金鑰（https://aistudio.google.com/apikey）：
# GEMINI_BACKEND=gemini
# GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_THINKING_LEVEL=high
# GEMINI_WAIT_SECONDS=45
